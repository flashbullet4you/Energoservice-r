PROVIDER=yandex

# YandexGPT
YANDEX_API_KEY=your_api_kei
YANDEX_FOLDER_ID=your_folder_id

# Система
DOC_DIR=./docs
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=6
INDEX_INTERVAL_MINUTES=30

# DWG конвертация
DWG_CACHE_DIR=./dwg_cache
DWG_CONVERTER_CMD=ODAFileConverter  # или путь: /usr/local/bin/ODAFileConverter